{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "jest"],
    "sourceMap": true,
    "rootDir": ".",
    "outDir": ".dist",

    "strict": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src", "tests"]
}
